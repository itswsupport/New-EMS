<mxfile host="app.diagrams.net" agent="ems-architecture">
  <diagram name="EMS Architecture" id="ems-arch-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Rucha EMS — System Architecture (multi-plant IIoT energy monitoring)" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== BANDS (background) ===================== -->
        <mxCell id="bandA" value="FIELD LAYER — per plant site (×12; only Plant 6 live today)" style="rounded=1;fillColor=#E3F2FD;strokeColor=#1565C0;opacity=50;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bandB" value="EDGE PLATFORM — ems-edge-platform (one Node/TS stack per plant, DEFAULT_PLANT_ID=plantNN)" style="rounded=1;fillColor=#E8F5E9;strokeColor=#2E7D32;opacity=50;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bandC" value="DATA LAYER — shared Postgres 16 + pgvector (container ems-postgres, network ems-net)" style="rounded=1;fillColor=#FFF3E0;strokeColor=#E65100;opacity=50;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1120" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bandD" value="APPLICATION — ems-ui (Next.js 15 App Router, SSR force-dynamic, MUI, :3400)" style="rounded=1;fillColor=#F3E5F5;strokeColor=#6A1B9A;opacity=50;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1120" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bandE" value="CLIENT" style="rounded=1;fillColor=#ECEFF1;strokeColor=#455A64;opacity=50;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=6;fontColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="1120" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== FIELD ===================== -->
        <mxCell id="meters" value="Energy meters&#10;RISH LM1360 + other brands&#10;(Modbus RTU slaves, 24 registers)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1565C0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="100" width="290" height="62" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="Modbus gateway&#10;X5050 (serial → TCP)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1565C0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="220" height="62" as="geometry" />
        </mxCell>

        <!-- ===================== EDGE ===================== -->
        <mxCell id="listener" value="gateway-listener&#10;Modbus FC03 poller&#10;(TCP :4196, ~5s cadence)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#2E7D32;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="250" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ingestion" value="ingestion-service&#10;resolveDevices() from DB registry (yaml fallback)&#10;stamps plant_id / tenant_id per record" style="rounded=1;fillColor=#FFFFFF;strokeColor=#2E7D32;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
