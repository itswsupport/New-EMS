        <!-- ===================== CALLOUTS ===================== -->
        <mxCell id="noteDeploy" value="DEPLOY&#10;host 192.168.100.30 : /opt/New-EMS (git, branch main)&#10;docker-compose · network ems-net · UI container :3400&#10;deploy = git pull on main + prisma migrate deploy + rebuild" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="210" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="noteDev" value="DEV LOOP&#10;local `next dev` :3400 + SSH tunnel&#10;5432 → ems-postgres (container IP drifts)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="noteScale" value="SCALE ROADMAP (see docs/timescale-migration.md)&#10;• rollup / continuous-aggregate tables (read speed) — zero-risk first&#10;• TimescaleDB hypertable + compression + retention&#10;• explicit plant_id belt on rollups (cross-plant isolation)&#10;• RLS + non-superuser reader role + real auth" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="400" width="330" height="150" as="geometry" />
