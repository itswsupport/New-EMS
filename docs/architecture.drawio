        <!-- ===================== CLIENT ===================== -->
        <mxCell id="browser" value="Browser — dashboards · plant switcher (cookie ems_plant) · Excel export · auto-refresh" style="rounded=1;fillColor=#FFFFFF;strokeColor=#455A64;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="828" width="480" height="46" as="geometry" />
