          <mxGeometry x="760" y="250" width="230" height="80" as="geometry" />
        </mxCell>

        <!-- ===================== DATA ===================== -->
        <mxCell id="registry" value="Registry (source of truth)&#10;tenant → plant → device&#10;(slave, parent_id, registers jsonb, area, hidden)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E65100;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="445" width="330" height="90" as="geometry" />
        </mxCell>
