        <mxCell id="actions" value="Server actions&#10;topology-actions.ts&#10;addDevice / setParent / setArea /&#10;rename / hide (writes device rows)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#6A1B9A;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
