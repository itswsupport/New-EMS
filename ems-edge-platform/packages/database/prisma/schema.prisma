// =============================================================================
// Prisma schema — native PostgreSQL (Prisma Accelerate intentionally NOT used).
//
// SCOPE NOTE: Prisma manages `energy_telemetry` (the hot ingestion path, where
// typed batch inserts matter). The pgvector extension and `plant_knowledge_base`
// table are provisioned by SQL migrations with a CONFIGURABLE dimension
// (${PG_VECTOR_DIMENSION}) — see packages/database/prisma/sql/ — because Prisma
// cannot parametrize a vector(N) dimension. The knowledge base is read/written
// via typed $queryRaw in KnowledgeRepository. This keeps dimension out of code.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Time-series energy measurements. One row per meter per poll cycle.
/// For very high volume, convert to a native time-partitioned / hypertable —
/// see docs/scaling.md. Indexes below cover the three primary query axes.
model EnergyTelemetry {
  id             BigInt   @default(autoincrement())
  deviceId       String   @map("device_id")
  tenantId       String   @map("tenant_id")
  plantId        String   @map("plant_id")
  timestamp      DateTime @db.Timestamptz(6)

  voltage        Float?
  current        Float?
  frequency      Float?
  powerFactor    Float?   @map("power_factor")
  activePower    Float?   @map("active_power")
  reactivePower  Float?   @map("reactive_power")
  apparentPower  Float?   @map("apparent_power")
  activeEnergy   Float?   @map("active_energy")
  reactiveEnergy Float?   @map("reactive_energy")
  thd            Float?

  // Per-phase (STEP 2) — imbalance detection + per-machine load breakdown
  voltageL1      Float?   @map("voltage_l1")
  voltageL2      Float?   @map("voltage_l2")
  voltageL3      Float?   @map("voltage_l3")
  currentL1      Float?   @map("current_l1")
  currentL2      Float?   @map("current_l2")
  currentL3      Float?   @map("current_l3")
  activePowerL1  Float?   @map("active_power_l1")
  activePowerL2  Float?   @map("active_power_l2")
  activePowerL3  Float?   @map("active_power_l3")
  powerFactorL1  Float?   @map("power_factor_l1")
  powerFactorL2  Float?   @map("power_factor_l2")
  powerFactorL3  Float?   @map("power_factor_l3")
  // Power quality — harmonic distortion (top predictive-maintenance signal)
  voltageThd     Float?   @map("voltage_thd")
  currentThd     Float?   @map("current_thd")
  // Maximum (apparent-power) demand — the utility-billed kVA demand
  maximumDemand  Float?   @map("maximum_demand")

  quality        String   @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Multi-plant segregation: rows reference a canonical plant (FK added in
  // migration 0004). The composite index serves plant-scoped reads.
  plant          Plant    @relation(fields: [plantId], references: [id])

  // Composite PK includes the partition column so the table can become a
  // TimescaleDB hypertable (migration 0006). `id` stays sequence-backed.
  @@id([id, timestamp])
  // Idempotency key: blocks duplicate rows from a retried batch (see migration
  // 0007). Also serves the (device_id, timestamp) read axis, replacing the old
  // non-unique idx_telemetry_device_ts.
  @@unique([deviceId, timestamp], map: "energy_telemetry_device_id_timestamp_key")
  @@index([tenantId, timestamp], name: "idx_telemetry_tenant_ts")
  @@index([plantId, timestamp], name: "idx_telemetry_plant_ts")
  @@index([plantId, deviceId, timestamp], name: "idx_telemetry_plant_device_ts")
  @@map("energy_telemetry")
}

/// The group / company that owns one or more plants (top of the hierarchy).
model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plants    Plant[]

  @@map("tenant")
}

/// A physical site. Per-plant commercial config (tariff, contract, tz) lives
/// here, not in the UI's env, so a new plant configures itself.
model Plant {
  id             String   @id
  tenantId       String   @map("tenant_id")
  name           String
  timezone       String   @default("Asia/Kolkata")
  tariffKvah     Decimal? @map("tariff_kvah") @db.Decimal(10, 4)
  contractKva    Decimal? @map("contract_kva") @db.Decimal(10, 2)
  demandBlockMin Int      @default(30) @map("demand_block_min")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  devices        Device[]
  telemetry      EnergyTelemetry[]

  @@index([tenantId], name: "idx_plant_tenant")
  @@map("plant")
}

/// The device registry — the DB source of truth for meters. Folds in both the
/// devices.yaml list and the former device_topology overlay (parent/rename/
/// hide/virtual), scoped by (plant_id, device_id). registers is the resolved
/// Modbus register map.
model Device {
  plantId     String   @map("plant_id")
  deviceId    String   @map("device_id")
  tenantId    String   @map("tenant_id")
  slave       Int?
  parentId    String?  @map("parent_id")
  displayName String?  @map("display_name")
  registers   Json     @default("{}") @db.JsonB
  byteOrder   String?  @map("byte_order")
  area        String?
  hidden      Boolean  @default(false)
  isVirtual   Boolean  @default(false) @map("is_virtual")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  plant       Plant    @relation(fields: [plantId], references: [id])

  @@id([plantId, deviceId])
  @@index([plantId], name: "idx_device_plant")
  @@map("device")
}
