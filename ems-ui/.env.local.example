# Dev on Windows: Postgres is NOT published on the EMS host, so forward it first.
#   On 192.168.100.30:
#     docker run -d --name pg-forward --network ems-net -p 127.0.0.1:5432:5432 \
#       alpine/socat tcp-listen:5432,fork,reuseaddr tcp-connect:ems-postgres:5432
#   Then from Windows, tunnel it over SSH:
#     ssh -N -L 5432:127.0.0.1:5432 root@192.168.100.30
DATABASE_URL=postgres://ems:REPLACE_ME@127.0.0.1:5432/ems

# In the compose stack on ems-net this becomes:
# DATABASE_URL=postgres://ems:REPLACE_ME@postgres:5432/ems

# Commercial constants, matching the Grafana dashboards.
NEXT_PUBLIC_TARIFF_INR_PER_KVAH=10.5
NEXT_PUBLIC_CONTRACT_KVA=300
